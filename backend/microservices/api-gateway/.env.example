PENIELGO_ENVIRONMENT=development
PENIELGO_PORT=8080
PENIELGO_CORS_ORIGINS=["http://localhost:5173"]
PENIELGO_REQUEST_TIMEOUT_SECONDS=10.0

# Docker Compose: these become http://user-service:8001 etc via service-name DNS.
# Local dev without Docker: point at whatever ports you ran each service on.
PENIELGO_USER_SERVICE_URL=http://localhost:8001
PENIELGO_ITINERARY_SERVICE_URL=http://localhost:8002
PENIELGO_RECOMMENDATION_SERVICE_URL=http://localhost:8003
